---
import LayoutPrado from '../layouts/LayoutPrado.astro'
import CardProducto from '../components/CardProducto.astro'
import productosJson from '../../../data/productos.json'
import type { ProductoJson } from '../lib/productos'

const destacados = (productosJson as ProductoJson[]).slice(0, 12)
---

<LayoutPrado title="Prado Print | Destacados">
  <div class="flex flex-col gap-8">
    <section>
      <h1 class="text-3xl font-bold tracking-wide text-stone-800">
        Destacados
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
        Seleccion estatica de productos generada en build con Astro SSG.
      </p>
    </section>

    <section class="grid grid-cols-1 gap-8 gap-y-10 pt-2 md:grid-cols-3 lg:grid-cols-4">
      {destacados.map((producto, index) => (
        <CardProducto
          título={producto.título}
          texto_precio={producto.texto_precio}
          imagen={producto.imagen}
          index={index}
        />
      ))}
    </section>
  </div>
</LayoutPrado>
