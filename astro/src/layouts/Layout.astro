---
import '../assets/app.css'

type Props = {
  title?: string
}

const { title = 'Prado Print' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="font-montserrat text-stone-800">
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-5">
        <a href="/" class="text-2xl font-bold tracking-tight text-stone-900">
          Prado Print
        </a>
        <nav class="flex items-center gap-5 text-sm">
          <a class="text-stone-500 hover:text-stone-900" href="/">Portada</a>
          <a class="text-stone-500 hover:text-stone-900" href="/carrousel">Carrusel</a>
          <a class="text-stone-500 hover:text-stone-900" href="/ssg">Destacados</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>
