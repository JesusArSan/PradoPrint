PORT=3000

POSTGRES_USER=pradoprint
POSTGRES_PASSWORD=pradoprint
POSTGRES_DB=pradoprint_ssbw

DATABASE_URL=postgresql://pradoprint:pradoprint@localhost:5432/pradoprint_ssbw?schema=public

SESSION_SECRET=cambiar_esto_en_produccion

SECRET_KEY=cambiar_esto_jwt_secret

# CORS — orígenes permitidos para la SPA (lista separada por comas, sin barra final).
# En desarrollo se añaden automáticamente http://localhost:5173 y http://127.0.0.1:5173.
# En producción es OBLIGATORIO si la SPA y el backend están en dominios distintos.
# Ejemplo: FRONTEND_ORIGIN=https://pradoprint.example.com
FRONTEND_ORIGIN=