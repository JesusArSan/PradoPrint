{% extends "base.njk" %}

{% block content %}

    <div class="row justify-content-center mt-5">
        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="mb-4 text-center" style="font-family: Georgia, serif;">
                        Crear cuenta
                    </h4>

                    {# Aviso si el email ya existe o es inválido #}
                    {% if error %}
                        <div class="alert alert-danger py-2 text-center">
                            {{ error }}
                        </div>
                    {% endif %}

                    <form action="/registro" method="POST">

                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text"
                                   id="nombre"
                                   name="nombre"
                                   class="form-control"
                                   placeholder="Tu nombre"
                                   required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="tu@email.com"
                                   required>
                        </div>

                        <div class="mb-4">
                            <label for="contraseña" class="form-label">Contraseña</label>
                            <input type="password"
                                   id="contraseña"
                                   name="contraseña"
                                   class="form-control"
                                   placeholder="••••••••"
                                   required>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            <i class="bi bi-person-plus me-2"></i>Registrarse
                        </button>

                    </form>

                    <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                        ¿Ya tienes cuenta?
                        <a href="/login" class="text-dark">Inicia sesión</a>
                    </p>

                </div>
            </div>

        </div>
    </div>

{% endblock %}