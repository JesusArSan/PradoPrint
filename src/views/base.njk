<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ title or 'Tienda Prado — Impresiones' }}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/styles.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    </head>
    <body>

        <nav class="navbar navbar-dark mb-4">
            <div class="container d-flex align-items-center gap-3">

                {# Logo / nombre de la tienda #}
                <a class="navbar-brand text-white me-0" href="/">Tienda Prado</a>

                {# Buscador centrado, ocupa el espacio disponible #}
                <form class="d-flex flex-grow-1" action="/buscar" method="get">
                    <input class="form-control me-2"
                           type="search"
                           name="busqueda"
                           placeholder="Buscar impresiones..."
                           value="{{ busqueda or '' }}">
                    <button class="btn btn-outline-light" type="submit">Buscar</button>
                </form>

                {# Login o logout según si hay usuario autentificado #}
                {% if usuario %}
                    <span class="text-white me-3" style="font-size: 0.9rem;">
                        <i class="bi bi-person-check me-1"></i>{{ usuario }}
                    </span>
                    <a href="/logout" class="text-white me-3 text-decoration-none"
                       title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right" style="font-size: 1.3rem;"></i>
                    </a>
                {% else %}
                    <a href="/login" class="text-white me-3 text-decoration-none"
                       title="Iniciar sesión">
                        <i class="bi bi-person" style="font-size: 1.3rem;"></i>
                    </a>
                {% endif %}

                {# Botón del carrito que abre offcanvas (sin recargar página) #}
                <button type="button"
                        class="btn text-white position-relative"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#carritoOffcanvas"
                        aria-controls="carritoOffcanvas"
                        style="background: none; border: none; font-size: 1.5rem; padding: 0;">
                    <i class="bi bi-cart3"></i>
                    {% if total_carrito > 0 %}
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark"
                              style="font-size: 0.6rem;">
                            {{ total_carrito }}
                        </span>
                    {% endif %}
                </button>

            </div>
        </nav>

        <main class="container mb-5">
            {% block content %}{% endblock %}
        </main>

        <footer class="py-4 mt-5">
            <div class="container text-center">
                <p class="mb-0">© Museo Nacional del Prado &mdash; Todos los derechos reservados</p>
            </div>
        </footer>

        <!-- Template para renderizar líneas del carrito offcanvas -->
        <template id="tmpl-linea-carrito">
            <div class="carrito-item">
                <img src="" alt="" class="carrito-item-img">
                <div class="carrito-item-info">
                    <div class="carrito-item-title"></div>
                    <div class="carrito-item-price"></div>
                    <div class="carrito-item-cantidad"></div>
                </div>
                <button type="button" class="carrito-item-btn-remove" title="Eliminar producto">
                    <i class="bi bi-trash3"></i>
                </button>
            </div>
        </template>

        <!-- Offcanvas del carrito (panel lateral) -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="carritoOffcanvas"
             aria-labelledby="carritoOffcanvasLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="carritoOffcanvasLabel">Tu cesta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                        aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body">
                <ul id="carrito-lista"></ul>
            </div>
            <div class="offcanvas-footer">
                <div class="carrito-total">
                    <span>Total:</span>
                    <span id="carrito-total-amount">0,00 €</span>
                </div>
                <a href="/carrito" class="btn btn-dark w-100">
                    <i class="bi bi-bag-check me-2"></i>Ver cesta completa
                </a>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/carrito-offcanvas.js"></script>

        {% block scripts %}{% endblock %}
    </body>
</html>