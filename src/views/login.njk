{% extends "base.njk" %}

{% block content %}

    <div class="row justify-content-center mt-5">
        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h4 class="mb-4 text-center" style="font-family: Georgia, serif;">
                        Iniciar sesión
                    </h4>

                    {# Aviso de error si las credenciales son incorrectas #}
                    {% if error %}
                        <div class="alert alert-danger py-2 text-center">
                            Email o contraseña incorrectos.
                        </div>
                    {% endif %}

                    <form action="/login" method="POST" novalidate>

                        {# Campo Email con validación on blur #}
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="tu@email.com"
                                   autocomplete="email"
                                   autofocus
                                   required>
                            <div class="invalid-feedback"></div>
                        </div>

                        {# Campo Contraseña con toggle + requisitos en tiempo real #}
                        <div class="mb-4">
                            <label for="contraseña" class="form-label">Contraseña</label>
                            <div class="input-group-password">
                                <input type="password"
                                       id="contraseña"
                                       name="contraseña"
                                       class="form-control"
                                       placeholder="••••••••"
                                       autocomplete="current-password"
                                       required>
                                <button type="button"
                                        id="toggle-password"
                                        class="toggle-password-btn"
                                        title="Mostrar/ocultar contraseña">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback"></div>

                            {# Requisitos de contraseña mostrados on focus #}
                            <div id="req-pass">
                                <small><strong>Requisitos:</strong></small>
                                <ul></ul>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
                        </button>

                    </form>

                    <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                        ¿No tienes cuenta?
                        <a href="/registro" class="text-dark">Regístrate</a>
                    </p>

                </div>
            </div>

        </div>
    </div>

{% endblock %}

{% block scripts %}
    <script src="/js/login-ux.js"></script>
{% endblock %}